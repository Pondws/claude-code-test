# --- Runtime ---
NODE_ENV=development
PORT=3000
# LOG_LEVEL=info
# Number of reverse proxies in front of the app (needed for correct client IPs / rate limiting).
TRUST_PROXY=0

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth?schema=public

# --- Tokens ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=auth-backend
JWT_AUDIENCE=auth-backend-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Brute-force protection ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Cookies / CORS ---
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=example.com
# Comma-separated list of allowed browser origins (required in production).
CORS_ORIGINS=http://localhost:5173

# --- Email ---
# Frontend URL used to build verification / reset links.
APP_URL=http://localhost:5173
# Leave SMTP_HOST empty in development to log emails instead of sending them (required in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Auth <no-reply@example.com>"
